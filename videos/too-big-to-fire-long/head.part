<!doctype html>
<html><head><meta charset="utf-8"><title>Too Big to Fire Long</title>
<style>
@font-face{font-family:G;src:url(data:font/woff2;base64,__GEIST__) format('woff2');font-weight:100 900}
@font-face{font-family:GM;src:url(data:font/woff2;base64,__MONO__) format('woff2');font-weight:500}
html,body{margin:0;background:#000;overflow:hidden}#c{position:absolute;left:0;top:0;transform-origin:0 0}
</style></head><body><canvas id="c"></canvas>
<script>
const Q=new URLSearchParams(location.search);const VERT=false;
const W=1920,H=1080,D=206.5;
const C=document.getElementById('c');C.width=W;C.height=H;const x=C.getContext('2d');
const VID={w:W,h:H,duration:D};const U=1;
function spring(t,w=14,z=.82){if(t<=0)return 0;const wd=w*Math.sqrt(1-z*z);return 1-Math.exp(-z*w*t)*(Math.cos(wd*t)+(z*w/wd)*Math.sin(wd*t));}
const clamp=(v,a=0,b=1)=>Math.min(b,Math.max(a,v)),lerp=(a,b,k)=>a+(b-a)*k,seg=(t,a,b)=>clamp((t-a)/(b-a));
const ease=v=>(v=clamp(v),v<.5?4*v*v*v:1-Math.pow(-2*v+2,3)/2),eo=v=>1-Math.pow(1-clamp(v),3);
const rng=s=>()=>(s=(s+0x6D2B79F5)|0,s=Math.imul(s^(s>>>15),1|s),s^=s+Math.imul(s^(s>>>7),61|s),((s^(s>>>14))>>>0)/4294967296);
function font(w,s,f='G'){x.font=`${w} ${s*U}px ${f}`;}
function txt(s,X,Y,col,al='center'){x.fillStyle=col;x.textAlign=al;x.textBaseline='middle';x.fillText(s,X,Y);}
function glowTxt(s,X,Y,col,glow,blur=40){x.save();x.shadowColor=glow;x.shadowBlur=blur*U;txt(s,X,Y,col);x.restore();}
function mk(w,h,fn){const c=document.createElement('canvas');c.width=w;c.height=h;fn(c.getContext('2d'),w,h);return c;}
// ---------- layout ----------
const PANEL_W=VERT?420:360,PANEL_H=PANEL_W*1458/1088;
const PANEL_X=VERT?(W-PANEL_W)/2:70,PANEL_Y=VERT?H-300-PANEL_H:H-48-40-PANEL_H;
const panelOn=t=>t<15.3;
// content focus point (keeps props clear of the panel while it is on screen)
function focus(t){const k=ease(seg(t,15.1,15.9));return VERT?{x:W/2,y:lerp(560,900,k)}:{x:lerp(W*0.6,W/2,k),y:lerp(H*0.42,H*0.46,k)};}

// ---------- backgrounds ----------
const SKY=[0,1,2].map(L=>mk(3200,1400,(g,w,h)=>{const R=rng(11+L);let X=0;const cols=[['#1b1433','#241a40'],['#140f28','#1d1636'],['#0c0a1a','#120f22']][L];
 while(X<w){const bw=80+R()*170,bh=(250+R()*600)*(1+L*.25);g.fillStyle=cols[R()<.5?0:1];g.fillRect(X,h-bh,bw,bh);
  for(let wy=h-bh+20;wy<h-10;wy+=26)for(let wx=X+12;wx<X+bw-14;wx+=22){if(R()<.16){g.fillStyle=`rgba(255,${190+R()*50|0},${110+R()*60|0},${.12+R()*.3})`;g.fillRect(wx,wy,10,13);}}X+=bw+R()*14;}}));
const GRAIN=[0,1,2,3].map(k=>mk(256,256,g=>{const R=rng(70+k),d=g.createImageData(256,256);for(let i=0;i<d.data.length;i+=4){const v=R()*255;d.data[i]=d.data[i+1]=d.data[i+2]=v;d.data[i+3]=13;}g.putImageData(d,0,0);}));
const VIG=mk(W,H,g=>{const r=g.createRadialGradient(W/2,H/2,Math.min(W,H)*.35,W/2,H/2,Math.max(W,H)*.75);r.addColorStop(0,'rgba(0,0,0,0)');r.addColorStop(1,'rgba(0,0,0,.65)');g.fillStyle=r;g.fillRect(0,0,W,H);});
const GLOW=mk(256,256,g=>{const r=g.createRadialGradient(128,128,0,128,128,128);r.addColorStop(0,'rgba(255,255,255,1)');r.addColorStop(.3,'rgba(255,255,255,.3)');r.addColorStop(1,'rgba(255,255,255,0)');g.fillStyle=r;g.fillRect(0,0,256,256);});
const TINT={};function glow(X,Y,r,col,a){const c=TINT[col]||(TINT[col]=mk(256,256,g=>{g.drawImage(GLOW,0,0);g.globalCompositeOperation='source-in';g.fillStyle=col;g.fillRect(0,0,256,256);}));x.save();x.globalCompositeOperation='lighter';x.globalAlpha=a;x.drawImage(c,X-r,Y-r,r*2,r*2);x.restore();}
// scene palette: [skyTop, skyMid, skyBottom]
function palette(t){if(t>=106.4&&t<145.7)return['#120a04','#3a2410','#8a5a2a'];if(t>=145.7&&t<166.5)return['#03070f','#0e2036','#2c5878'];return['#06050e','#22163d','#8c3f36'];}
function background(t){const [a,b,c]=palette(t);const g=x.createLinearGradient(0,0,0,H);g.addColorStop(0,a);g.addColorStop(.55,b);g.addColorStop(1,c);x.fillStyle=g;x.fillRect(0,0,W,H);
 const drift=t*18,base=H*(VERT?.66:.86),sc=(VERT?.75:.55);[.15,.35,.6].forEach((p,i)=>{x.save();x.globalAlpha=((t>=26&&t<40.7)?.35:.85)*(.55+i*.2);x.drawImage(SKY[i],-300-drift*p*2,base-1400*sc+i*25,3200*sc,1400*sc);x.restore();});
 x.fillStyle='rgba(5,4,10,.9)';x.fillRect(0,base,W,H-base);}
function rain(t,front){const R=rng(front?3:8),n=front?110:170,sp=front?2300:1500,len=(front?44:24)*U;x.strokeStyle=front?'rgba(200,210,255,.30)':'rgba(170,180,230,.20)';x.lineWidth=(front?2.2:1.3)*U;x.beginPath();
 for(let i=0;i<n;i++){const x0=R()*W*1.2,y0=R()*H,ph=R();const y=((y0+t*sp+ph*H)%(H+100))-50;const xx=((x0-t*sp*.18)%(W*1.2)+W*1.2)%(W*1.2)-W*.1;x.moveTo(xx,y);x.lineTo(xx-len*.18,y+len);}x.stroke();}
function embers(t){const R=rng(21);for(let i=0;i<40;i++){const x0=R()*W,ph=R(),sp=40+R()*60;const y=H-((t*sp+ph*H)%(H+50));const a=.3+.5*Math.abs(Math.sin(t*2+i));glow(x0+Math.sin(t+i)*20,y,8*U,'#ffb35c',a);}}

// ---------- props ----------
function stamp(t,at,label,col,X,Y,sz=110){if(t<at)return;const s=spring(t-at,20,.5);x.save();x.translate(X,Y);x.rotate(-.12);x.scale(lerp(2.2,1,s),lerp(2.2,1,s));x.globalAlpha=clamp(s*1.5);x.strokeStyle=col;x.lineWidth=10*U;font(900,sz);const w=x.measureText(label).width/2+40*U;x.strokeRect(-w,-sz*.75*U,w*2,sz*1.5*U);txt(label,0,0,col);x.restore();}
function calendar(X,Y,s,day){x.save();x.translate(X,Y);x.scale(s*U,s*U);x.shadowColor='rgba(0,0,0,.6)';x.shadowBlur=40;x.fillStyle='#efe6cf';x.beginPath();x.roundRect(-260,-280,520,560,24);x.fill();x.shadowBlur=0;
 x.fillStyle='#d8432b';x.beginPath();x.roundRect(-260,-280,520,130,[24,24,0,0]);x.fill();x.font='900 70px G';x.fillStyle='#fff';x.textAlign='center';x.textBaseline='middle';x.fillText('NOVEMBER',0,-215);x.font='900 260px G';x.fillStyle='#141414';x.fillText(String(day),0,60);
 [-150,150].forEach(o=>{x.fillStyle='#222';x.beginPath();x.arc(o,-280,18,0,7);x.fill();});x.restore();}
function phone(X,Y,s,t){x.save();x.translate(X,Y);x.scale(s*U,s*U);const sh=(Math.floor(t*3)%2)?Math.sin(t*70)*4:0;x.translate(sh,0);glow(0,0,260,'#4ea3ff',.35);x.fillStyle='#111';x.beginPath();x.roundRect(-85,-160,170,320,26);x.fill();x.fillStyle='#2f6fd8';x.beginPath();x.roundRect(-70,-130,140,250,14);x.fill();
 x.font='900 34px G';x.fillStyle='#fff';x.textAlign='center';x.textBaseline='middle';x.fillText('INCOMING',0,-60);x.font='500 22px GM';x.fillText('CALL',0,-20);x.fillStyle='#3fd17a';x.beginPath();x.arc(0,70,26,0,7);x.fill();x.restore();
 x.strokeStyle='rgba(120,180,255,.5)';x.lineWidth=4*U;for(let i=1;i<=3;i++){const r=((t*1.2+i/3)%1);x.globalAlpha=1-r;x.beginPath();x.arc(X,Y,(180+r*200)*s*U,0,7);x.stroke();}x.globalAlpha=1;}
function table(X,Y,s){x.save();x.translate(X,Y);x.scale(s*U,s*U);x.fillStyle='#2a1a10';x.beginPath();x.ellipse(0,0,520,130,0,0,7);x.fill();x.strokeStyle='#5a3a22';x.lineWidth=6;x.stroke();for(let i=0;i<10;i++){const a=i/10*Math.PI*2;x.fillStyle='#120c08';x.beginPath();x.ellipse(Math.cos(a)*600,Math.sin(a)*175-20,46,60,0,0,7);x.fill();}x.restore();}
function ceo(X,Y,s,t){x.save();x.translate(X,Y);x.scale(s*U,s*U);const cone=x.createLinearGradient(0,-520,0,120);cone.addColorStop(0,'rgba(255,240,200,.35)');cone.addColorStop(1,'rgba(255,240,200,0)');x.fillStyle=cone;x.beginPath();x.moveTo(-40,-520);x.lineTo(40,-520);x.lineTo(220,120);x.lineTo(-220,120);x.fill();
 x.fillStyle='#0b0b10';x.beginPath();x.arc(0,-210,60,0,7);x.fill();x.beginPath();x.moveTo(-120,100);x.quadraticCurveTo(-120,-120,0,-130);x.quadraticCurveTo(120,-120,120,100);x.fill();x.fillStyle='#c33';x.beginPath();x.moveTo(-10,-125);x.lineTo(10,-125);x.lineTo(0,-40);x.fill();x.restore();}
function tower(X,baseY,h,w,lit,red,t){const flick=red&&(Math.floor(t*14)%3!==0);const top=baseY-h;
 x.fillStyle='#0d1912';x.beginPath();x.moveTo(X-w/2,baseY);x.lineTo(X-w/2,top+w*.3);x.lineTo(X,top);x.lineTo(X+w/2,top+w*.3);x.lineTo(X+w/2,baseY);x.fill();
 const R=rng(5),rows=Math.floor((h-w*.35)/(30*U)),cols=Math.max(5,Math.floor(w/(42*U)));for(let f=0;f<rows;f++){const fy=baseY-30*U-f*30*U;const on=f/rows<lit*1.25;for(let c=0;c<cols;c++){const r=R();if(r<.25)continue;const wx=X-w/2+(c+.5)*w/cols-11*U;
  x.fillStyle=on?(red?(flick?`rgba(255,60,50,${.5+r*.5})`:'rgba(40,20,20,.6)'):`rgba(118,255,${150+r*80|0},${.45+r*.55})`):'rgba(30,50,40,.8)';x.fillRect(wx,fy,22*U,17*U);}}
 const col=red?(flick?'#ff3c32':'#3a1a1a'):'#76ff9a';if(lit>0||red){glow(X,top+40*U,360*U,col,.5*(red?(flick?1:.3):lit));font(900,64);x.save();x.shadowColor=col;x.shadowBlur=20;txt('NVIDIA',X,top+w*.45,col);x.restore();}}
function library(X,Y,s,t,lockAt){x.save();x.translate(X,Y);x.scale(s*U,s*U);const w=760,h=640;
 for(let i=0;i<2;i++){const sx=-w/2+i*(w-190);x.fillStyle='#2a170b';x.fillRect(sx,-h/2,190,h);for(let r=0;r<6;r++){const y=-h/2+r*(h/6);x.fillStyle='#160c05';x.fillRect(sx,y+h/6-10,190,10);for(let k=0;k<7;k++){x.fillStyle=['#7a2a1a','#2d4a5c','#8a6a2a','#3a4a2a','#5a2a40'][(r*3+k+i)%5];x.fillRect(sx+8+k*26,y+16,20,h/6-28);}}}
 const dw=300,dh=500,dy=h/2-dh;const close=ease(seg(t,lockAt,lockAt+.7));x.fillStyle='#0a0503';x.fillRect(-dw/2,dy,dw,dh);glow(0,dy+dh*.5,260,'#ffb35c',.6*(1-close));
 [[-1],[1]].forEach(([sg])=>{const ww=dw/2*lerp(.18,1,close);x.fillStyle='#6a3e1e';x.strokeStyle='#2a170b';x.lineWidth=6;if(sg<0){x.fillRect(-dw/2,dy,ww,dh);x.strokeRect(-dw/2,dy,ww,dh);}else{x.fillRect(dw/2-ww,dy,ww,dh);x.strokeRect(dw/2-ww,dy,ww,dh);}});
 if(close>=1){const k=spring(t-lockAt-.7,20,.5);x.save();x.translate(0,dy+dh*.5);x.scale(k,k);x.strokeStyle='#d9b45a';x.lineWidth=14;x.beginPath();x.arc(0,-40,40,Math.PI,0);x.stroke();x.fillStyle='#d9b45a';x.beginPath();x.roundRect(-60,-40,120,100,10);x.fill();x.restore();}
 [-330,330].forEach(cx=>{glow(cx,-h/2-40,120,'#ffb35c',.7+.2*Math.sin(t*9+cx));x.fillStyle='#efe0b0';x.fillRect(cx-8,-h/2-30,16,50);});x.restore();}
function vault(X,Y,s,t){x.save();x.translate(X,Y);x.scale(s*U,s*U);x.fillStyle='#4a5560';x.beginPath();x.arc(0,0,300,0,7);x.fill();x.fillStyle='#7d8994';x.beginPath();x.arc(0,0,250,0,7);x.fill();x.strokeStyle='#2a323a';x.lineWidth=8;for(let i=0;i<24;i++){const a=i/24*Math.PI*2;x.beginPath();x.arc(Math.cos(a)*275,Math.sin(a)*275,8,0,7);x.stroke();}
 x.save();x.rotate(t*.6);x.strokeStyle='#c9d2da';x.lineWidth=22;x.lineCap='round';for(let i=0;i<3;i++){const a=i*Math.PI/1.5;x.beginPath();x.moveTo(-Math.cos(a)*170,-Math.sin(a)*170);x.lineTo(Math.cos(a)*170,Math.sin(a)*170);x.stroke();}x.restore();x.fillStyle='#d9b45a';x.beginPath();x.arc(0,0,50,0,7);x.fill();x.restore();}

